.DS_Store
.projectmem/

# Raw per-run eval transcripts (fixture copies + captured outputs). Hand-
# authored runs/*.md writeups stay tracked; only the raw per-run
# subdirectories are ignored.
evals/*/runs/*/

# evidence-verification fixtures need real git history + a real SQLite
# ledger, not just files to read -- each case's repo/ is generated
# deterministically by its own setup.sh (fixed dates/content -> fixed
# SHAs) rather than committed as a nested repo.
evals/evidence-verification/cases/*/repo/

# halp fixtures need real git history (mid-merge state, staged/unstaged/
# untracked mixes), so each case's repo/ is generated by its setup.sh from
# evals/halp/fixture-lib.sh rather than committed as a nested repo.
evals/halp/cases/*/repo/

# halp held-out fixtures are generated by setup.sh from evals/halp-heldout/fixture-lib.sh
evals/halp-heldout/cases/*/repo/
evals/halp-heldout/cases/*/bin/
evals/halp-heldout/runs/*/
