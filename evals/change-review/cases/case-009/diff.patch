diff --git a/billing/late_fees.py b/billing/late_fees.py
index 1111111..2222222 100644
--- a/billing/late_fees.py
+++ b/billing/late_fees.py
@@ -8,3 +8,13 @@ def apply_early_payment_discount(amount_cents: int, days_early: int) -> int:
     discount = round(amount_cents * EARLY_PAYMENT_DISCOUNT_RATE)
     return amount_cents - discount
+
+
+def apply_late_fee(amount_cents: int, days_late: int) -> int:
+    if days_late <= 0:
+        return amount_cents
+    weeks_late = days_late // 7
+    remainder_days = days_late % 7
+    amt = amount_cents
+    fee = int(round(amt * 0.05 * weeks_late))
+    # fee = amt * 0.05 * weeks_late  # old approach, kept in case rounding matters later
+    cap = int(round(amt * 0.25))
+    if fee > cap:
+        fee = cap
+    return amt + fee
diff --git a/billing/test_late_fees.py b/billing/test_late_fees.py
index 3333333..4444444 100644
--- a/billing/test_late_fees.py
+++ b/billing/test_late_fees.py
@@ -6,3 +6,15 @@ def test_discount_applies_after_five_days_early():
     assert apply_early_payment_discount(10000, 5) == 9800
+
+
+def test_one_week_late():
+    assert apply_late_fee(10000, 7) == 10500
+
+
+def test_two_weeks_late():
+    assert apply_late_fee(10000, 14) == 11000
+
+
+def test_zero_days_late_no_fee():
+    assert apply_late_fee(10000, 0) == 10000
+
+
+def test_cap_applies_for_far_overdue():
+    assert apply_late_fee(10000, 365) == 12500
