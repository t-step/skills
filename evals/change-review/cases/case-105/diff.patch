diff --git a/api/test_middleware.py b/api/test_middleware.py
new file mode 100644
index 0000000..4444444
--- /dev/null
+++ b/api/test_middleware.py
@@ -0,0 +1,16 @@
+from api.middleware import handle_request
+from rate_limiter.token_bucket import TokenBucketRateLimiter
+
+
+def test_allows_request_under_limit():
+    TokenBucketRateLimiter._buckets.clear()
+    resp = handle_request(object())
+    assert resp.status_code == 200
+
+
+def test_blocks_when_rate_limited():
+    TokenBucketRateLimiter._buckets.clear()
+    for _ in range(TokenBucketRateLimiter.CAPACITY):
+        handle_request(object())
+    resp = handle_request(object())
+    assert resp.status_code == 429
