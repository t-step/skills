--- a/api/upload.py
+++ b/api/upload.py
@@ -1,9 +1,26 @@
+from datetime import datetime, timedelta
+
 from framework import Response

+RATE_LIMIT = 10
+WINDOW_SECONDS = 60
+_requests = {}  # user_id -> list[datetime] of recent request times
+
+
+def _is_rate_limited(user_id: str, now: datetime) -> bool:
+    timestamps = _requests.setdefault(user_id, [])
+    cutoff = now - timedelta(seconds=WINDOW_SECONDS)
+    timestamps[:] = [t for t in timestamps if t > cutoff]
+    if len(timestamps) >= RATE_LIMIT:
+        return True
+    timestamps.append(now)
+    return False
+
+
 def handle_upload(user_id: str, file_data: bytes) -> Response:
+    if _is_rate_limited(user_id, datetime.utcnow()):
+        return Response("Too many requests", status=429)
     # ... existing upload handling, unrelated to rate limiting
     store_file(user_id, file_data)
     return Response("OK", status=200)
