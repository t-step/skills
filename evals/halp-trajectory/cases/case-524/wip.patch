+def _parse_regex_csv(value: str) -> list[str]:
+    """Split a comma-separated string of regular expressions.
+
+    Commas inside braces, brackets, or parentheses are not treated as
+    separators, so that regular expressions using quantifiers such as
+    ``{1,3}`` or character classes like ``[a,b]`` are not broken up.
+    """
+    result: list[str] = []
+    current = ""
+    paren_depth = 0
+    bracket_depth = 0
+    brace_depth = 0
+    i = 0
+    while i < len(value):
+        ch = value[i]
+
+        if ch == "\\" and i + 1 < len(value):
+            # Escaped character – take both backslash and next char literally
+            current += value[i : i + 2]
+            i += 2
+            continue
+
+        if bracket_depth:
+            # Inside a character class only an unescaped ']' closes it
+            current += ch
+            if ch == "]":
+                bracket_depth -= 1
+            i += 1
+            continue
+
+        if ch == "[":
+            bracket_depth += 1
+            current += ch
+        elif ch == "(":
+            paren_depth += 1
+            current += ch
+        elif ch == ")":
+            paren_depth = max(0, paren_depth - 1)
+            current += ch
+        elif ch == "{":
+            brace_depth += 1
+            current += ch
+        elif ch == "}":
+            brace_depth = max(0, brace_depth - 1)
+            current += ch
+        elif ch == "," and not paren_depth and not brace_depth:
+            current = current.strip()
+            if current:
+                result.append(current)
+            current = ""
+        else:
+            current += ch
+
+        i += 1
+
+    current = current.strip()
+    if current:
+        result.append(current)
+
+    return result
+
