diff --git a/notify/digest.py b/notify/digest.py
index 1111111..2222222 100644
--- a/notify/digest.py
+++ b/notify/digest.py
@@ -1,7 +1,25 @@
+import logging
+
+from notify.mailer import send_email
+from notify.subscriptions import list_subscribed_users
+from notify.templates import render_digest
+
+log = logging.getLogger(__name__)
+
+
+def send_digest_email_batch():
+    sent, failed = 0, 0
+    for user in list_subscribed_users():
+        try:
+            body = render_digest(user)
+            send_email(user.email, subject="Your daily digest", body=body)
+            sent += 1
+        except Exception:
+            log.exception("digest send failed for user_id=%s", user.id)
+            failed += 1
+    return {"sent": sent, "failed": failed}
diff --git a/notify/test_digest.py b/notify/test_digest.py
index 3333333..4444444 100644
--- a/notify/test_digest.py
+++ b/notify/test_digest.py
@@ -1,3 +1,25 @@
+from unittest.mock import patch, MagicMock
+
+from notify.digest import send_digest_email_batch
+
+
+def test_batch_continues_after_individual_failure():
+    users = [MagicMock(id=1, email="a@example.com"), MagicMock(id=2, email="b@example.com")]
+    with patch("notify.digest.list_subscribed_users", return_value=users):
+        with patch("notify.digest.render_digest", return_value="body"):
+            with patch("notify.digest.send_email", side_effect=[Exception("smtp timeout"), None]):
+                result = send_digest_email_batch()
+    assert result == {"sent": 1, "failed": 1}
