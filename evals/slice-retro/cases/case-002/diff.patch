diff --git a/profiles/service.py b/profiles/service.py
index 1111111..2222222 100644
--- a/profiles/service.py
+++ b/profiles/service.py
@@ -1,7 +1,20 @@
+from collections import OrderedDict
+
 from profiles.upstream import fetch_profile_from_upstream

+_CACHE = OrderedDict()
+_CACHE_SIZE = 128
+

 def get_user_profile(user_id):
-    return fetch_profile_from_upstream(user_id)
+    if user_id in _CACHE:
+        _CACHE.move_to_end(user_id)
+        return _CACHE[user_id]
+    profile = fetch_profile_from_upstream(user_id)
+    _CACHE[user_id] = profile
+    _CACHE.move_to_end(user_id)
+    if len(_CACHE) > _CACHE_SIZE:
+        _CACHE.popitem(last=False)
+    return profile
diff --git a/profiles/test_service.py b/profiles/test_service.py
index 3333333..4444444 100644
--- a/profiles/test_service.py
+++ b/profiles/test_service.py
@@ -1,3 +1,20 @@
+from unittest.mock import patch
+
+from profiles.service import get_user_profile, _CACHE
+
+
+def test_second_call_hits_cache():
+    _CACHE.clear()
+    with patch("profiles.service.fetch_profile_from_upstream", return_value={"id": 1}) as mock_fetch:
+        get_user_profile(1)
+        get_user_profile(1)
+    assert mock_fetch.call_count == 1
+
+
+def test_cache_evicts_oldest_over_capacity():
+    _CACHE.clear()
+    with patch("profiles.service.fetch_profile_from_upstream", side_effect=lambda uid: {"id": uid}):
+        for uid in range(200):
+            get_user_profile(uid)
+    assert len(_CACHE) == 128
