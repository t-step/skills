index 1111111..2222222 100644
--- a/orders/views.py
+++ b/orders/views.py
@@ -1,5 +1,22 @@
+from django.http import JsonResponse
+
+from orders.models import Order
+
+
 def list_orders(request):
-    orders = Order.objects.all()[:50]
-    return JsonResponse({"orders": [o.to_dict() for o in orders]})
+    limit = min(int(request.GET.get("limit", 50)), 100)
+    cursor = request.GET.get("cursor")
+    qs = Order.objects.order_by("id")
+    if cursor:
+        qs = qs.filter(id__gt=int(cursor))
+    orders = list(qs[: limit + 1])
+    next_cursor = orders[limit].id if len(orders) > limit else None
+    orders = orders[:limit]
+    return JsonResponse({
+        "orders": [o.to_dict() for o in orders],
+        "next_cursor": next_cursor,
+    })
diff --git a/orders/test_views.py b/orders/test_views.py
index 3333333..4444444 100644
--- a/orders/test_views.py
+++ b/orders/test_views.py
@@ -1,3 +1,20 @@
+import pytest
+
+
+@pytest.mark.django_db
+def test_default_limit_and_next_cursor(client, orders_fixture_120):
+    response = client.get("/api/orders")
+    data = response.json()
+    assert len(data["orders"]) == 50
+    assert data["next_cursor"] == data["orders"][-1]["id"]
+
+
+@pytest.mark.django_db
+def test_cursor_continues_from_previous_page(client, orders_fixture_120):
+    first = client.get("/api/orders").json()
+    second = client.get("/api/orders", {"cursor": first["next_cursor"]}).json()
+    assert second["orders"][0]["id"] > first["orders"][-1]["id"]
+
+
+@pytest.mark.django_db
+def test_last_page_has_no_next_cursor(client, orders_fixture_120):
+    response = client.get("/api/orders", {"cursor": 119, "limit": 100})
+    assert response.json()["next_cursor"] is None
