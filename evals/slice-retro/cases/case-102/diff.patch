diff --git a/validation/test_email.py b/validation/test_email.py
index 3333333..4444444 100644
--- a/validation/test_email.py
+++ b/validation/test_email.py
@@ -1,3 +1,15 @@
+from validation.email import is_valid_email
+
+
+def test_rejects_missing_at_sign():
+    assert is_valid_email("no-at-sign.example.com") is False
+
+
+def test_rejects_double_at_sign():
+    assert is_valid_email("a@@b.com") is False
+
+
+def test_rejects_empty_string():
+    assert is_valid_email("") is False
+
+
+def test_rejects_missing_domain():
+    assert is_valid_email("user@") is False
+
+
+def test_accepts_ordinary_address():
+    assert is_valid_email("user@example.com") is True
