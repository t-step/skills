diff --git a/checkout/test_views.py b/checkout/test_views.py
index 3333333..4444444 100644
--- a/checkout/test_views.py
+++ b/checkout/test_views.py
@@ -1,3 +1,15 @@
+from unittest.mock import patch
+
+from checkout.views import checkout
+
+
+def test_routes_to_v2_when_flag_enabled(rf):
+    request = rf.post("/checkout")
+    with patch("checkout.views.is_enabled", return_value=True):
+        with patch("checkout.views.process_checkout_v2") as mock_v2:
+            checkout(request)
+    mock_v2.assert_called_once()
+
+
+def test_routes_to_legacy_when_flag_disabled(rf):
+    request = rf.post("/checkout")
+    with patch("checkout.views.is_enabled", return_value=False):
+        with patch("checkout.views.process_checkout_legacy") as mock_legacy:
+            checkout(request)
+    mock_legacy.assert_called_once()
