diff --git a/search/views.py b/search/views.py
index 1111111..2222222 100644
--- a/search/views.py
+++ b/search/views.py
@@ -1,3 +1,17 @@
+from django.db import connection
+from django.http import JsonResponse
+
+
+def search(request):
+    q = request.GET.get("q", "").strip()
+    if not q:
+        return JsonResponse({"results": []})
+    with connection.cursor() as cur:
+        cur.execute(
+            "SELECT id, title FROM articles_fts WHERE articles_fts MATCH %s LIMIT 20",
+            [q],
+        )
+        rows = cur.fetchall()
+    return JsonResponse({"results": [{"id": r[0], "title": r[1]} for r in rows]})
