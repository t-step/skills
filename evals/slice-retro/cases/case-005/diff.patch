+@pytest.mark.django_db
+def test_search_returns_matching_articles(client, fts_fixture):
+    response = client.get("/search", {"q": "kubernetes"})
+    titles = [r["title"] for r in response.json()["results"]]
+    assert "Kubernetes networking basics" in titles
+    assert "Unrelated article" not in titles
+
+
+@pytest.mark.django_db
+def test_search_caps_at_20_results(client, fts_fixture_25_matches):
+    response = client.get("/search", {"q": "python"})
+    assert len(response.json()["results"]) == 20
