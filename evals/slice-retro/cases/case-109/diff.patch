+"""Generic phone-number normalization utility.
+
+Not tied to signup or any other specific flow -- built as a standalone
+helper so any part of the app that needs this formatting later can just
+import it.
+"""
+import re
+
+
+def normalize_phone_number(raw: str) -> str | None:
+    digits = re.sub(r"\D", "", raw)
+    if len(digits) == 10:
+        return f"+1{digits}"
+    if len(digits) == 11 and digits.startswith("1"):
+        return f"+{digits}"
+    return None
diff --git a/utils/test_phone.py b/utils/test_phone.py
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/utils/test_phone.py
@@ -0,0 +1,12 @@
+from utils.phone import normalize_phone_number
+
+
+def test_ten_digit_number():
+    assert normalize_phone_number("555-123-4567") == "+15551234567"
+
+
+def test_eleven_digit_with_leading_one():
+    assert normalize_phone_number("1 (555) 123-4567") == "+15551234567"
+
+
+def test_garbage_input_returns_none():
+    assert normalize_phone_number("not a number") is None
