@@ -0,0 +1,20 @@
+from reports.export import export_orders_csv
+
+
+def test_export_three_orders():
+    orders = [
+        {"order_id": 1, "customer_email": "a@example.com", "total_cents": 1099, "created_at": "2026-08-01T10:00:00Z"},
+        {"order_id": 2, "customer_email": "b@example.com", "total_cents": 500, "created_at": "2026-08-02T11:00:00Z"},
+        {"order_id": 3, "customer_email": "c@example.com", "total_cents": 2500, "created_at": "2026-08-03T12:00:00Z"},
+    ]
+    csv_text = export_orders_csv(orders)
+    lines = csv_text.strip().splitlines()
+    assert lines[0] == "order_id,customer_email,total_cents,created_at"
+    assert lines[1] == "1,a@example.com,1099,2026-08-01T10:00:00Z"
+    assert lines[3] == "3,c@example.com,2500,2026-08-03T12:00:00Z"
