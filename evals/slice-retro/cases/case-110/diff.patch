@@ -0,0 +1,17 @@
+import csv
+import io
+
+
+def export_orders_csv(orders) -> str:
+    buf = io.StringIO()
+    writer = csv.writer(buf)
+    writer.writerow(["order_id", "customer_email", "total_cents", "created_at"])
+    for order in orders:
+        writer.writerow([
+            order["order_id"],
+            order["customer_email"],
+            order["total_cents"],
+            order["created_at"],
+        ])
+    return buf.getvalue()
