+from email.send_queue import EmailService
+
+def test_email_service_enqueues(monkeypatch):
+    calls = []
+    monkeypatch.setattr("email.send_queue.queue.enqueue", lambda *a, **k: calls.append((a, k)))
+    EmailService.send("a@example.com", "Subject", "Body")
+    assert calls
