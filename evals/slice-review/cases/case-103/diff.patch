@@ -0,0 +1,7 @@
+from comments.sanitize import sanitize_html
+
+def test_strips_script_tag():
+    assert sanitize_html('hello <script>alert(1)</script> world') == 'hello  world'
+
+def test_leaves_plain_text_alone():
+    assert sanitize_html('just plain text') == 'just plain text'
