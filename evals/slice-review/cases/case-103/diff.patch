@@ -0,0 +1,9 @@
+import re
+
+SCRIPT_TAG_RE = re.compile(r"<script.*?>.*?</script>", re.IGNORECASE | re.DOTALL)
+
+
+def sanitize_html(text: str) -> str:
+    """Removes all <script> tags and on* event-handler attributes to
+    prevent stored XSS in rendered comments."""
+    return SCRIPT_TAG_RE.sub("", text)
diff --git a/comments/test_sanitize.py b/comments/test_sanitize.py
