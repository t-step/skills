+++ b/integrations/meridian_client.py
@@ -0,0 +1,19 @@
+from meridian_sdk import MeridianClient
+
+_client = MeridianClient()
+
+_STATUS_MAP = {
+    "IN_TRANSIT": "in_transit",
+    "OUT_FOR_DELIVERY": "in_transit",
+    "DELIVERED": "delivered",
+    "EXCEPTION": "exception",
+}
+
+
+def get_shipment_status(shipment_id: str) -> str:
+    """Look up a shipment's status via the Meridian Freight SDK and normalize it."""
+    try:
+        tracking = _client.track(shipment_id)
+        return _STATUS_MAP.get(tracking.status, "unknown")
+    except Exception:
+        return "unknown"
