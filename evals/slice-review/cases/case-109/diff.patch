diff --git a/inventory/restock.py b/inventory/restock.py
index 1111111..2222222 100644
--- a/inventory/restock.py
+++ b/inventory/restock.py
@@ -14,3 +14,13 @@ def days_until_stockout(units_on_hand: int, daily_usage_rate: float) -> int:
     if daily_usage_rate <= 0:
         return -1
     return int(units_on_hand / daily_usage_rate)
+
+
+def should_expedite_reorder(units_on_hand: int, daily_usage_rate: float) -> bool:
+    if daily_usage_rate <= 0:
+        return False
+    remaining_days = days_until_stockout(units_on_hand, daily_usage_rate)
+    lead_time = 5
+    if remaining_days == -1:
+        return False
+    return remaining_days < lead_time
