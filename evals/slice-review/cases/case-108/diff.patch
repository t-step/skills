@@ -0,0 +1,10 @@
+from shipping.cost import shipping_cost
+
+def test_light_package():
+    assert shipping_cost(1) == 5
+
+def test_medium_package():
+    assert shipping_cost(5) == 10
+
+def test_heavy_package():
+    assert shipping_cost(10) == 20
