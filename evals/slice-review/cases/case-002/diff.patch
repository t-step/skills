diff --git a/checkout/pricing.py b/checkout/pricing.py
index 1111111..2222222 100644
--- a/checkout/pricing.py
+++ b/checkout/pricing.py
@@ -1,10 +1,21 @@
 from decimal import Decimal

 TAX_RATE = Decimal("0.08")


+def apply_discount(price: Decimal, pct: Decimal) -> Decimal:
+    """Return price reduced by pct percent (e.g. pct=20 removes 20%)."""
+    return price - (price * pct / Decimal("100"))
+
+
 def compute_total(price: Decimal, pct: Decimal) -> Decimal:
-    """Compute total with tax, no discount support yet."""
-    tax = price * TAX_RATE
-    return price + tax
+    """Compute total with discount applied, then tax on top."""
+    tax = price * TAX_RATE
+    discounted = apply_discount(price, pct)
+    return discounted + tax
