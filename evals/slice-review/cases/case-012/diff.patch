+def test_csv_header_matches_columns():
+    assert rows_to_csv([], ["name", "amount"]) == "name,amount\n"
+
+
+def test_csv_single_row_in_column_order():
+    rows = [{"name": "Ada", "amount": 100}]
+    assert rows_to_csv(rows, ["name", "amount"]) == "name,amount\nAda,100\n"
